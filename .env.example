# OpenAI-compatible endpoint used by `persian-rag ask` (and `--embedder openai`).

# OpenAI
PERSIAN_RAG_BASE_URL=https://api.openai.com/v1
PERSIAN_RAG_API_KEY=sk-...
PERSIAN_RAG_MODEL=gpt-4o-mini

# OpenRouter
# PERSIAN_RAG_BASE_URL=https://openrouter.ai/api/v1
# PERSIAN_RAG_API_KEY=sk-or-...
# PERSIAN_RAG_MODEL=meta-llama/llama-3.1-70b-instruct

# Local Ollama (no API key needed)
# PERSIAN_RAG_BASE_URL=http://localhost:11434/v1
# PERSIAN_RAG_MODEL=qwen2.5:7b
